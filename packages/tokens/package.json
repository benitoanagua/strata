{
  "name": "@strata/tokens",
  "version": "4.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.json": "./src/tokens.json",
    "./fonts.css": "./dist/fonts.css"
