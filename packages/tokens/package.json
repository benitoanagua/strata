{
  "name": "@strata/tokens",
  "version": "4.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.json": "./src/tokens.json",
    "./fonts.css": "./dist/fonts.css"
  },
  "files": [
    "dist",
    "src/tokens.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node build-css.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "node validate.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "license": "MIT",
  "description": "STRATA design tokens — colors, spacing, typography as CSS custom properties and JSON",
  "keywords": [
    "design-tokens",
    "design-system",
    "css-variables",
    "strata"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benitoanagua/strata.git",
    "directory": "packages/tokens"
  },
  "bugs": {
    "url": "https://github.com/benitoanagua/strata/issues"
  },
  "homepage": "https://github.com/benitoanagua/strata#readme"
}
