{
  "name": "@strata/testing",
  "version": "2.5.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run src",
    "test:visual": "playwright test visual",
    "test:a11y": "playwright test visual/a11y.spec.ts",
    "test:contracts": "vitest run src/**/*.test.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@strata/components": "workspace:*",
    "@strata/core": "workspace:*",
    "@strata/tokens": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.12"
  }
}
